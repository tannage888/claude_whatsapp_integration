# Claude WhatsApp Integration — environment variables
# Copy to `.env` and edit as needed.

# REST API
PORT=3100
BIND_ADDRESS=127.0.0.1

# Optional bearer token. If unset, API is open (default).
# WA_GATEWAY_TOKEN=change-me-to-a-random-string

# WhatsApp pairing — if set, uses pairing-code flow instead of QR.
# Format: E.164 with leading +
# WHATSAPP_PHONE=+447700900123

# Storage paths
AUTH_STATE_PATH=./auth_state
STATE_DB_PATH=./state.db
MESSAGE_STORE_PATH=./auth_state/wa_store.json

# Behaviour
BACKFILL_MAX_MESSAGES_PER_CHAT=500
MEMBERSHIP_REFRESH_HOURS=24

# Logging
LOG_LEVEL=info

# Live-push incoming WhatsApp messages to Kit's MessageRouter
# WA_INCOMING_HOOK_URL=http://127.0.0.1:3141/api/incoming-message
